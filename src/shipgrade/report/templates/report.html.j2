<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>shipgrade report - Grade {{ score.grade }}</title>
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; max-width: 820px;
    margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; line-height: 1.5; }
  .grade { font-size: 2.4rem; font-weight: 700; }
  .band { display: inline-block; padding: 0 .5rem; border-radius: .25rem; color: #fff;
    font-size: .8rem; font-weight: 600; }
  .card { border: 1px solid #e0e0e0; border-radius: .5rem; padding: 1rem; margin: 1rem 0; }
  .muted { color: #666; font-size: .85rem; }
  .evidence { background: #f6f6f6; padding: .5rem; border-radius: .25rem;
    font-family: monospace; font-size: .85rem; white-space: pre-wrap; }
  footer { margin-top: 2rem; color: #666; font-size: .8rem; border-top: 1px solid #e0e0e0;
    padding-top: 1rem; }
</style>
</head>
<body>
  <header>
    <div class="grade">Grade {{ score.grade }} {{ score.score }}/100</div>
    <div class="muted">{{ score.scale_version }} scale &middot;
      {{ meta.started_at.date().isoformat() }} &middot; target {{ meta.target.identity }}</div>
    <p>{{ grade_explainer }}</p>
    <p class="muted">{{ coverage_banner }}</p>
  </header>

  <section>
    <h2>Explain to my boss</h2>
    <p>{{ exec_summary }}</p>
  </section>

  <section>
    <h2>Findings by severity</h2>
    <p>critical {{ score.counts_by_band.get('critical', 0) }} &middot;
       high {{ score.counts_by_band.get('high', 0) }} &middot;
       medium {{ score.counts_by_band.get('medium', 0) }} &middot;
       low {{ score.counts_by_band.get('low', 0) }}</p>
  </section>

  <section>
    {% for f in findings %}
    <div class="card">
      <span class="band" style="background: {{ band_hex[f.severity_band] }}">{{ f.severity_band|upper }} {{ f.severity_score }}/10</span>
      <h3>{{ f.title }}</h3>
      <p><strong>What this means:</strong> {{ f.description }}</p>
      <p><strong>We saw:</strong></p>
      <div class="evidence">{{ f.evidence.response_excerpt }}</div>
      <p><strong>Fix:</strong> {{ f.fix }}</p>
      <p class="muted">OWASP {{ f.category }} &middot; ATLAS {{ f.atlas_technique or 'n/a' }}
        &middot; confidence {{ f.confidence }}</p>
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>Accepted-risk waivers</h2>
    {%- if waivers %}
    <ul class="muted">
      {%- for w in waivers %}
      <li><code>{{ w.fingerprint }}</code>: {{ w.reason }}{%- if w.expires %} (expires {{ w.expires.isoformat() }}){% endif %}</li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="muted">None.</p>
    {%- endif %}
    <h2>Errored or skipped probes</h2>
    {% if report.errored_probes %}
    <p class="muted">{{ report.errored_probes|length }} probe(s) did not complete.</p>
    {% else %}
    <p class="muted">None.</p>
    {% endif %}
  </section>

  <footer>
    <p>tool {{ meta.tool_version }} &middot; probe packs {{ meta.probe_pack_versions }}
      &middot; rule packs {{ meta.rule_pack_versions }} &middot; {{ score.scale_version }}</p>
    <p>{{ disclaimer }}</p>
    <p>{{ severity_note }}</p>
    <p>Generated by <a href="https://github.com/RivetaLabs/shipgrade">shipgrade</a>.
      Grade your own LLM feature: <code>uvx shipgrade demo</code></p>
  </footer>
</body>
</html>
